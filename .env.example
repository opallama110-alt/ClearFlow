# Salin menjadi .env.local untuk menjalankan `npm run dev` terhadap Firebase production.
# Untuk pengembangan tanpa menyentuh production, gunakan `npm run emulators` + `npm run dev:emulators`
# (konfigurasinya ada di .env.e2e).

# Provider Google harus diaktifkan di Firebase Authentication sebelum nilai ini true.
VITE_ENABLE_GOOGLE_AUTH=true

# Wajib untuk Firebase AI Logic dan Firestore karena App Check ditegakkan.
# Site key reCAPTCHA Enterprise bersifat publik (sama dengan .env.production).
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Hanya untuk pengembangan lokal: daftarkan debug token di Firebase Console. Jangan aktifkan di production.
VITE_FIREBASE_APPCHECK_DEBUG=false

# Arahkan Auth dan Firestore ke Firebase Emulator Suite (hanya berlaku di localhost).
VITE_USE_FIREBASE_EMULATORS=false
