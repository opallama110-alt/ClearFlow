# Provider Google harus diaktifkan di Firebase Authentication sebelum nilai ini true.
VITE_ENABLE_GOOGLE_AUTH=true

# Wajib untuk Firebase AI Logic setelah App Check ditegakkan.
# Buat reCAPTCHA Enterprise key untuk clearfloww.web.app, lalu isi nilainya di .env.local.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Hanya untuk pengembangan lokal. Jangan aktifkan pada build production.
VITE_FIREBASE_APPCHECK_DEBUG=false

# Opsional: arahkan Auth dan Firestore ke Firebase Emulator Suite saat npm run dev.
VITE_USE_FIREBASE_EMULATORS=false
