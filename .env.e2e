# Dipakai oleh `vite --mode e2e` untuk pengujian lokal terhadap Firebase Emulator Suite.
# Tidak ada data production yang tersentuh: proyek emulator memakai ID demo-clearflow.
VITE_USE_FIREBASE_EMULATORS=true
VITE_ENABLE_GOOGLE_AUTH=true
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_APPCHECK_DEBUG=false
